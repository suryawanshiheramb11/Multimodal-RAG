# Copy to .env and fill in. Never commit .env — it is gitignored.
# The pipeline reads the DB password from the environment only; a `password:`
# key in config.yaml is deliberately ignored.
EVIDENCE_DB_PASSWORD=
# Optional overrides (these take precedence over config.yaml):
# EVIDENCE_DB_HOST=localhost
# EVIDENCE_DB_PORT=5432
# EVIDENCE_DB_DBNAME=evidence_db
# EVIDENCE_DB_USER=postgres
# EVIDENCE_DB_SSLMODE=prefer
